# ==============================================================================
# Regras de Firewall IPTables para o Roteador/Firewall
# ==============================================================================
*filter
:INPUT DROP [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]

# Permitir tráfego loopback local
-A INPUT -i lo -j ACCEPT

# Permitir conexões já estabelecidas ou relacionadas
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT

# Permitir serviços essenciais na rede interna (DNS/DHCP via Dnsmasq)
-A INPUT -p udp --dport 53 -j ACCEPT
-A INPUT -p tcp --dport 53 -j ACCEPT
-A INPUT -p udp --dport 67:68 -j ACCEPT

COMMIT
