# ==============================================================================
# Configuração do Servidor Web Nginx (Virtual Host padrão)
# ==============================================================================
server {
    # Porta de escuta para tráfego HTTP padrão
    listen 80;
    server_name web.empresa.local;

    # Diretório raiz dos ficheiros web da aplicação
    root /var/www/html;
    index index.html index.htm app.py;

    # Bloco de localização e tratamento de pedidos
    location / {
        try_files $uri $uri/ =404;
    }
}
